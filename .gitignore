# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# generated files
**/*.g.dart
**/*.freezed.dart
**/*.mapper.dart
**/*.gen.dart
**/*.dll
**/*.dylib
**/*.xcframework
/dist/
/dist_docker/

/assets/core/*
!/assets/core/.gitkeep

# Code-signing material. None of this belongs in git, and a leaked private key
# or .p8 lets someone ship a build as us. Generate it OUTSIDE the repo; these
# rules are the second line of defence, not the first.
**/*.p12
**/*.p8
**/*.cer
**/*.certSigningRequest
**/*.mobileprovision
**/*.provisionprofile
**/*.keystore
**/*.jks

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release


/data
.cxx

# Windows Self-Signed for msix
windows/sign.pfx
windows/sign.cer

#VS Code
.vs/

#generated
linux/flutter/generated_*
windows/flutter/generated_*
macos/flutter/generated_*
Claude.md
.claude/*
.vscode/settings.json
pubspec.lock
macos/Flutter/GeneratedPluginRegistrant.swift

# Orphaned getsentry crashpad checkouts, left on disk after Sentry was removed.
# These were untracked gitlinks (no .gitmodules entry), which made
# `git submodule status` fail outright. Nothing in any build file references
# them; the directories can be deleted whenever convenient.
external/


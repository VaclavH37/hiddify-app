# Code-signing material. None of this belongs in git, and a leaked private key
# or .p8 lets someone ship a build as us. Generate it OUTSIDE the repo; these
# rules are the second line of defence, not the first.
**/*.p12
**/*.p8
**/*.cer
**/*.certSigningRequest
**/*.mobileprovision
**/*.provisionprofile
**/*.keystore
**/*.jks

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release


/data
.cxx

# Windows Self-Signed for msix
windows/sign.pfx
windows/sign.cer

#VS Code
.vs/

#generated
linux/flutter/generated_*
windows/flutter/generated_*
macos/flutter/generated_*
Claude.md
.claude/*
.vscode/settings.json
pubspec.lock
macos/Flutter/GeneratedPluginRegistrant.swift

# Orphaned getsentry crashpad checkouts, left on disk after Sentry was removed.
# These were untracked gitlinks (no .gitmodules entry), which made
# `git submodule status` fail outright. Nothing in any build file references
# them; the directories can be deleted whenever convenient.
external/


# Captured diagnostics. A single reproduction can drop a 105 MB box.log and a
# copy of %APPDATA% (sealed configs, the Drift DB, the secure-storage blob) into
# the tree — one `git add -A` from being published. Keep captures local.
/diagnostic-logs/
/CrashReport*.log
/Build Runner*.txt
/*.xcactivitylog

# Internal build/ops documentation — deliberately NOT published. These describe
# the signing material, the build hosts, the secret-handling procedure and the
# backend topology, and several quote host names and identifiers verbatim.
#
# Listed because they were untracked-by-convention and that is not a control:
# a targeted `git add CORE_BUILD.md` alongside a real change put two of them
# into commits that were only caught before push by luck. Ignoring them makes
# `git add <path>` refuse without `-f`.
#
# Only the FILENAMES appear here, never the contents.
/CORE_BUILD.md
/IOS_BUILD.md
/IOS_DEPLOYMENT.md
/OUTSTANDING_ISSUES_REPORT.md
/PLAY-SUBMISSION.md
/RAYN-LINK-SYMMETRIC-MIGRATION.md
/RULESETS.md
/ios-remote-mac-fast-testing-guide.md
/remnawave-hub-exit-architecture-review.md
/IAP_Integration/

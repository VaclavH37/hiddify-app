<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Must stay a subset of Runner.entitlements. content-filter-provider in
         particular is gone on purpose: this target is an
         NEPacketTunnelProvider, it has never contained a content filter, and
         asking a consumer VPN's App ID for the capability to inspect and block
         other apps' traffic is a question you do not want to be answering in
         App Review. -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.$(BASE_BUNDLE_IDENTIFIER)</string>
    </array>
    <!-- No keychain-access-groups here either — see the long note in
         Runner.entitlements. The application-groups entitlement above is what
         lets ConfigKey.peek() read the sealed-config key out of
         `group.com.raynlabs.app` on an on-demand start. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.developer.networking.vpn.api</key>
    <array>
        <string>allow-vpn</string>
    </array>
</dict>
</plist>

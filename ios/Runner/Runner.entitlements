<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- packet-tunnel-provider only. app-proxy-provider and dns-proxy were
	     inherited from upstream and are not used: RaynTunnel is an
	     NEPacketTunnelProvider and nothing else. An entitlement you do not use
	     still has to be granted by the App ID, so asking for three widens the
	     capability set for nothing.

	     There is deliberately NO aps-environment here. It was `development`
	     with zero push code in the tree, and the App ID is being created
	     WITHOUT the Push capability -- a profile from a non-Push App ID does not
	     authorize aps-environment and codesign fails outright, so this had to go
	     before the profiles were generated rather than at submission time. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.developer.networking.vpn.api</key>
	<array>
		<string>allow-vpn</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(BASE_BUNDLE_IDENTIFIER)</string>
	</array>
	<!-- Shares the config-sealing key with the packet-tunnel extension, which
	     must read it on an on-demand start with the app not running. On iOS an
	     App Group is already a valid keychain access group; listing it here
	     makes the dependency explicit and keeps it working if the group and the
	     access group ever diverge. -->
	<key>keychain-access-groups</key>
	<array>
		<string>group.$(BASE_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>

// Target-level base configuration for the macOS RaynTunnel extension.
//
// Rayn identity, team and app group: the same values the Runner target gets
// through AppInfo.xcconfig.
#include "../Runner/Configs/Rayn.xcconfig"

// FLUTTER_BUILD_NAME / FLUTTER_BUILD_NUMBER, regenerated from pubspec.yaml on
// every build, so the extension's MARKETING_VERSION / CURRENT_PROJECT_VERSION
// track the app. An extension whose version disagrees with its containing app
// is an App Store Connect rejection (ITMS-90473), which is how the iOS extension
// once sat at upstream Hiddify's 4.1.2 while the app shipped 1.3.x.
//
// This file ONLY, never Flutter-Debug.xcconfig or Flutter-Release.xcconfig:
// those also include the Pods-Runner settings, and the extension must not link
// FlutterMacOS or any plugin. Required rather than optional so a missing file
// fails with its own name (run `flutter pub get` or `flutter build macos` first).
#include "../Flutter/ephemeral/Flutter-Generated.xcconfig"

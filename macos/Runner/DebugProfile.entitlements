<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug and Profile builds. Identical to Release.entitlements, where each
	     entry is explained, plus allow-jit, which the Dart VM needs to JIT in a
	     debug build. Keep the two files in step: a difference between them is a
	     difference between what you test and what ships. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(RAYN_APP_GROUP)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(DEVELOPMENT_TEAM).$(BASE_BUNDLE_IDENTIFIER)</string>
		<string>$(RAYN_APP_GROUP)</string>
	</array>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
